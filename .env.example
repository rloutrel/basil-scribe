# Django settings module
DJANGO_SETTINGS_MODULE=basil_scribe.settings

# Optional .env file loaded by settings.py when set (docker compose sets
# this so the web container picks up the file mounted at /.env).
# DJANGO_ENV_FILE=.env

# Django secret key (generate one: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())")
DJANGO_SECRET_KEY=change-me

# Comma-separated list of allowed hosts
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Set to True only for development
DJANGO_DEBUG=False

# PostgreSQL connection — either a single DATABASE_URL
DATABASE_URL=postgresql://basil:basil@db:5432/basil_scribe
# …or discrete variables (used when DATABASE_URL is not set)
# POSTGRES_DB=basil_scribe
# POSTGRES_USER=basil
# POSTGRES_PASSWORD=basil
# POSTGRES_HOST=db
# POSTGRES_PORT=5432

# Optional: local time zone (default UTC)
# DJANGO_TIME_ZONE=Europe/Paris

# Optional: directory for collectstatic output (default ./staticfiles).
# Static files are served by WhiteNoise; no separate web server needed.
# DJANGO_STATIC_ROOT=./staticfiles

# Directory containing one <name>.yaml file per profile.
# The docker compose setup mounts ./profiles there, read-write, so
# profiles can be edited after deployment without a rebuild.
# PROFILES_DIR=/app/profiles

# Root of the read-only mail archive mount; each profile scans the
# MAIL_EXPORT_ROOT/<profile.mail_source>/ subfolder.
# MAIL_EXPORT_ROOT=/data/mail-exports

# LLM (Ollama, reached through the OpenAI SDK — see core/llm.py)
# Default inside docker compose: the bundled `ollama` service.
# Reusing an Ollama already running on the Docker host? Apply the
# docker-compose.host-ollama.yml override — see README.
OLLAMA_BASE_URL=http://ollama:11434/v1
LLM_MODEL=llama3.1:8b

# Model pulled by the entrypoint into the Ollama volume at first start.
OLLAMA_PULL_MODEL=llama3.1:8b

# Embeddings (FlagEmbedding BGEM3FlagModel — see core/embeddings.py).
# Device is resolved here; use_fp16 is only set when the device is not cpu.
# Never hardcoded to "mps" or "cuda".
EMBED_DEVICE=cpu
EMBED_MODEL=BAAI/bge-m3

# Default generation temperature; each profile can override it with the
# `temperature` key of its YAML file.
# DEFAULT_LLM_TEMPERATURE=0.7

# Host port for the web service in docker compose (default 8000).
# WEB_PORT=8000

# Log level for the project loggers (default INFO).
# BASIL_LOG_LEVEL=INFO
